# Copy to .env and fill in. A platform appears in the UI only when all its vars are set.

# ── General ──────────────────────────────────────────────────────────
# PORT=3000
# HOST=127.0.0.1
# Contact address the KeepItRollin form asks for
CONTACT_EMAIL=

# Browser automation
# DRY_RUN=1        fill forms but never click submit

# ── fraktvred.com (Sanity) — creates a DRAFT, publish it in the Studio ──
SANITY_PROJECT_ID=fgntxxeb
# Use a test dataset while trying this out
SANITY_DATASET=production
# Editor token (sanity.io/manage → API → Tokens)
SANITY_TOKEN=

# ── Eventbrite ───────────────────────────────────────────────────────
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=
# EVENTBRITE_CAPACITY=200

# ── Email submissions: Neo Group (events@neo-group.de), visitBerlin (events@visitberlin.de) ──
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=
# Override the recipients for testing
# NEO_GROUP_TO=
# VISITBERLIN_TO=

# ── KeepItRollin (public form) ───────────────────────────────────────
# Comma-separated genre labels exactly as on the form:
# Drum&Bass, IDM/Glitch/Breakcore, HipHop/Rap/Trap, Techno/House/Electro, Rock/Indie,
# Downtempo/Dub, Garage/Grime/Dubstep, Hardcore/Rave, Breakbeat/BigBeat, Jungle,
# Reggae/Dancehall, Trance/Prog/Psy
# KEEPITROLLIN_GENRES=Drum&Bass,Jungle

# ── Ströer Kulturkalender Berlin (REST API of Ströer's service portal, ticket.edgar.de) ──
# Login of the registered organizer account
STROEER_USER=
STROEER_PASSWORD=
# Image credit sent with the motif
# STROEER_COPYRIGHT=Fraktvred
