# Copy to .env and fill in. A platform appears in the UI only when all its vars are set.

# ── General ──────────────────────────────────────────────────────────
# PORT=3000
# HOST=127.0.0.1
# Contact address the public submission forms ask for (KeepItRollin, In-München)
CONTACT_EMAIL=

# Browser automation
# HEADLESS=false   show the browser (captchas, manual-submit platforms)
# DRY_RUN=1        fill forms but never click submit
# SLOW_MO=250

# ── fraktvred.com (Sanity) — creates a DRAFT, publish it in the Studio ──
SANITY_PROJECT_ID=fgntxxeb
# Use a test dataset while trying this out
SANITY_DATASET=production
# Editor token (sanity.io/manage → API → Tokens)
SANITY_TOKEN=

# ── Eventbrite ───────────────────────────────────────────────────────
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=
# EVENTBRITE_CAPACITY=200
# Unset = leave as draft; 1 = publish immediately
# EVENTBRITE_PUBLISH=1

# ── Neo Group (email to events@neo-group.de) ─────────────────────────
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=
# Override the recipient for testing
# NEO_GROUP_TO=

# ── KeepItRollin (public form) ───────────────────────────────────────
# Comma-separated genre labels exactly as on the form:
# Drum&Bass, IDM/Glitch/Breakcore, HipHop/Rap/Trap, Techno/House/Electro, Rock/Indie,
# Downtempo/Dub, Garage/Grime/Dubstep, Hardcore/Rave, Breakbeat/BigBeat, Jungle,
# Reggae/Dancehall, Trance/Prog/Psy
# KEEPITROLLIN_GENRES=Drum&Bass,Jungle

# ── In-München (public form, Cloudflare Turnstile → may need HEADLESS=false) ──
# Regex matched against the category dropdown
# IN_MUENCHEN_CATEGORY=party|club|nachtleben
# IN_MUENCHEN_COPYRIGHT=Fraktvred

# ── Login platforms: form not recorded yet → filled by label, you submit by hand ──
RA_USER=
RA_PASSWORD=
RA_SUBMIT_URL=
# RA_LOGIN_URL=https://ra.co/login

VISITBERLIN_USER=
VISITBERLIN_PASSWORD=
VISITBERLIN_LOGIN_URL=
VISITBERLIN_SUBMIT_URL=

BANDSINTOWN_USER=
BANDSINTOWN_PASSWORD=
# The artist's "add event" page in Bandsintown for Artists
BANDSINTOWN_SUBMIT_URL=
# BANDSINTOWN_LOGIN_URL=https://artists.bandsintown.com/login

STROEER_USER=
STROEER_PASSWORD=
STROEER_LOGIN_URL=
STROEER_SUBMIT_URL=
